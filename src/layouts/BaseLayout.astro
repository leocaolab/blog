---
import BaseHead from "../components/BaseHead.astro"
import { SITE, NAV } from "../consts.ts"
import "../styles/global.css"

interface Props {
  title: string
  description: string
  ogImage?: string
  publishedTime?: string
  type?: "website" | "article"
}

const { title, description, ogImage, publishedTime, type } = Astro.props
const path = Astro.url.pathname
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={title}
      description={description}
      ogImage={ogImage}
      publishedTime={publishedTime}
      type={type}
    />
  </head>
  <body>
    <header class="site-header">
      <a href="/" class="brand">{SITE.title}</a>
      <nav>
        {
          NAV.map((item) => (
            <a
              href={item.href}
              aria-current={
                item.href === "/"
                  ? path === "/"
                    ? "page"
                    : undefined
                  : path.startsWith(item.href)
                    ? "page"
                    : undefined
              }
            >
              {item.label}
            </a>
          ))
        }
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <p>
        © {new Date().getFullYear()} {SITE.author} ·
        <a href="/rss.xml">RSS</a> ·
        <a href={SITE.github}>GitHub</a>
      </p>
      <p class="muted">
        Code: MIT · Prose: CC BY-NC 4.0
      </p>
    </footer>
  </body>
</html>
